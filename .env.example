# ── Base de données (docker-compose) ─────────────────────────────────────────
# Copier en .env pour surcharger les valeurs par défaut du docker-compose.
DB_NAME=ndadiee
DB_USER=ndadiee
DB_PASSWORD=ndadiee
DB_PORT=5434

# ── Backend ──────────────────────────────────────────────────────────────────
# Variables d'environnement lues par application.yaml. Toutes ont une valeur par
# défaut pour le développement ; celles ci-dessous sont à définir en production.

# Clé de signature des JWT, en Base64 (256 bits minimum) : openssl rand -base64 48
JWT_SECRET=
# Origine du front autorisée par le CORS
FRONTEND_URL=http://localhost:5173
# Données de démonstration : à désactiver, ou à protéger par de vrais mots de passe
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
