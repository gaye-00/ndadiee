# ── Base de données (docker-compose) ─────────────────────────────────────────
# Copier en .env pour surcharger les valeurs par défaut du docker-compose.
DB_NAME=ndadiee
DB_USER=ndadiee
DB_PASSWORD=ndadiee
DB_PORT=5434

# ── Backend ──────────────────────────────────────────────────────────────────
# Variables d'environnement lues par application.yaml. Les secrets doivent être générés localement.

# Obligatoire pour démarrer : openssl rand -base64 48
JWT_SECRET=
# Origine du front autorisée par le CORS
FRONTEND_URL=http://localhost:5173
# Les seeders sont désactivés par défaut. Pour un environnement local dédié, passer à true
# et renseigner les trois mots de passe ci-dessous.
SEED_ENABLED=false
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# Comptes d'essai Ada et Musa (développement seulement)
SEED_TEST_ACCOUNT_PASSWORD=

# ── Images du forum : Cloudflare R2 (API compatible S3) ──────────────────────
# Sans ces réglages, les images vont sur le disque du backend (backend/uploads), pour le développement.
# Dès qu'ils sont tous remplis, elles vont dans le bucket. STORAGE_PROVIDER=r2 l'impose en production.
# Jeton : tableau de bord Cloudflare > R2 > Gérer les jetons d'API > « Lecture et écriture d'objets » sur le bucket.
STORAGE_PROVIDER=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Adresse publique des fichiers : le domaine relié au bucket (https://media.exemple.com) ou son adresse r2.dev
R2_PUBLIC_URL=

# ── E-mails : codes de vérification de l'inscription, notifications des revues ─
# En production (profil prod, application-prod.yaml), par le SMTP Hostinger. Ailleurs, rien ne part : chaque e-mail
# est noté dans le journal du backend, code de vérification compris (dans l'objet).
MAIL_USERNAME=no-reply@hautetech.org
MAIL_PASSWORD=

# ── Connexion avec GitHub et Google (OAuth) ──────────────────────────────────
# Sans ces réglages, les boutons « Continuer avec GitHub / Google » restent « bientôt ».
# Adresse de retour à déclarer chez le fournisseur : <FRONTEND_URL>/auth/callback/github et /auth/callback/google
# (en développement : http://localhost:5173/auth/callback/...), à l'identique, sans « wildcard ».
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
