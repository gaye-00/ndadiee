@@ -0,0 +1,69 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+/** Rows rendered above and below the viewport, so a fast fling never shows blank space. */
+const DEFAULT_OVERSCAN = 6;
+
+export interface VirtualRange {
+  /** Rows to render: from start (included) to end (excluded). */
+  start: number;
+  end: number;
+  /** Space kept above and below the rendered rows, in pixels. */
+  offsetTop: number;
+  offsetBottom: number;
+}
+
+interface Options {
+  count: number;
+  rowHeight: number;
+  overscan?: number;
+}
+
+/** The rows worth rendering for a scroll position: the visible ones, plus the overscan on each side. */
+export function computeRange(scrollTop: number, viewport: number, { count, rowHeight, overscan = DEFAULT_OVERSCAN }: Options): VirtualRange {
+  const first = Math.floor(scrollTop / rowHeight);
+  const visible = Math.ceil(viewport / rowHeight);
+  const start = Math.max(0, first - overscan);
+  const end = Math.min(count, first + visible + overscan);
+  return {
+    start,
+    end,
+    offsetTop: start * rowHeight,
+    offsetBottom: (count - end) * rowHeight,
+  };
+}
+
+/**
+ * Follows the scroll position of `container` and returns the rows worth rendering.
+ * Scroll events are coalesced to one update per animation frame.
+ */
+export function useVirtualRange<T extends HTMLElement>(options: Options) {
+  const container = useRef<T>(null);
+  const frame = useRef(0);
+  const [range, setRange] = useState(() => computeRange(0, 0, options));
+
+  const measure = useCallback(() => {
+    const element = container.current;
+    if (!element) return;
+    setRange(computeRange(element.scrollTop, element.clientHeight, options));
+  }, [options.count, options.rowHeight, options.overscan]);
+
+  useEffect(() => {
+    const element = container.current;
+    if (!element) return;
+    measure();
+    const onScroll = () => {
+      cancelAnimationFrame(frame.current);
+      frame.current = requestAnimationFrame(measure);
+    };
+    const resize = new ResizeObserver(measure);
+    element.addEventListener('scroll', onScroll, { passive: true });
+    resize.observe(element);
+    return () => {
+      cancelAnimationFrame(frame.current);
+      element.removeEventListener('scroll', onScroll);
+      resize.disconnect();
+    };
+  }, [measure]);
+
+  return { container, range };
+}
