+import type { ReactNode } from 'react';
+import { useVirtualRange } from './useVirtualRange';
+import './VirtualList.css';
+
+export interface VirtualListProps<T> {
+  items: readonly T[];
+  /** Every row has the same height, in pixels: nothing to measure, no layout shift. */
+  rowHeight: number;
+  /** Height of the scrolling area: pixels, or any CSS length. */
+  height: number | string;
+  renderRow: (item: T, index: number) => ReactNode;
+  getKey: (item: T, index: number) => string | number;
+  overscan?: number;
+  /** Accessible name of the list. */
+  label: string;
+}
+
+/** A list that only mounts its visible rows: thousands of items, a few dozen nodes. */
+export function VirtualList<T>({ items, rowHeight, height, renderRow, getKey, overscan, label }: VirtualListProps<T>) {
+  const { container, range } = useVirtualRange<HTMLDivElement>({ count: items.length, rowHeight, overscan });
+
+  const rows: ReactNode[] = [];
+  for (let index = range.start; index < range.end; index++) {
+    const item = items[index];
+    rows.push(
+      <li
+        key={getKey(item, index)}
+        className="pw-virtual-list__row"
+        style={{ height: rowHeight }}
+        aria-setsize={items.length}
+        aria-posinset={index + 1}
+      >
+        {renderRow(item, index)}
+      </li>,
+    );
+  }
+
+  return (
+    <div ref={container} className="pw-virtual-list" style={{ height }} tabIndex={0}>
+      <ul aria-label={label} style={{ paddingTop: range.offsetTop, paddingBottom: range.offsetBottom }}>
+        {rows}
+      </ul>
+    </div>
+  );
+}
