+import { render, screen } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+import { VirtualList } from './VirtualList';
+import { computeRange } from './useVirtualRange';
+
+const items = Array.from({ length: 5000 }, (_, index) => ({ id: index, name: `Article ${index + 1}` }));
+
+describe('computeRange', () => {
+  it('renders the visible rows and the overscan', () => {
+    expect(computeRange(0, 400, { count: 5000, rowHeight: 40, overscan: 6 })).toEqual({
+      start: 0,
+      end: 16,
+      offsetTop: 0,
+      offsetBottom: 4984 * 40,
+    });
+  });
+
+  it('keeps the overscan above the first visible row', () => {
+    const range = computeRange(4000, 400, { count: 5000, rowHeight: 40, overscan: 6 });
+    expect(range.start).toBe(94);
+    expect(range.end).toBe(116);
+  });
+
+  it('never goes past the last row', () => {
+    const range = computeRange(199_800, 400, { count: 5000, rowHeight: 40 });
+    expect(range.end).toBe(5000);
+    expect(range.offsetBottom).toBe(0);
+  });
+});
+
+describe('VirtualList', () => {
+  it('mounts a few dozen rows for 5 000 items', () => {
+    render(
+      <VirtualList items={items} rowHeight={40} height={400} label="Inventaire" getKey={(item) => item.id} renderRow={(item) => item.name} />,
+    );
+    expect(screen.getByRole('list', { name: 'Inventaire' })).toBeInTheDocument();
+    expect(screen.getAllByRole('listitem').length).toBeLessThan(30);
+  });
+});
