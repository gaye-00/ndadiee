diff --git a/internal/schedule/cache.go b/internal/schedule/cache.go
new file mode 100644
index 0000000..665215d
--- /dev/null
+++ b/internal/schedule/cache.go
@@ -0,0 +1,39 @@
+package schedule
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/redis/go-redis/v9"
+)
+
+// Cache keeps the next departures of each stop in Redis, in front of the GTFS source.
+type Cache struct {
+	rdb    *redis.Client
+	source Source
+}
+
+// Departures returns the next departures of a stop: from Redis when the key exists, from the source otherwise.
+func (c *Cache) Departures(ctx context.Context, stopID string) ([]Departure, error) {
+	key := fmt.Sprintf("departures:%s", stopID)
+	if cached, err := c.rdb.Get(ctx, key).Bytes(); err == nil {
+		return decode(cached)
+	}
+	deps, err := c.source.Departures(ctx, stopID)
+	c.rdb.Set(ctx, key, encode(deps), 0)
+	return deps, err
+}
+
+func NewCache(rdb *redis.Client, source Source) *Cache {
+	return &Cache{rdb: rdb, source: source}
+}
+
+// Warm loads the busiest stops at startup, so the first riders of the day do not wait.
+func (c *Cache) Warm(ctx context.Context, stops []string) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	for _, stop := range stops {
+		_, _ = c.Departures(ctx, stop)
+	}
+}
diff --git a/internal/schedule/cache_test.go b/internal/schedule/cache_test.go
new file mode 100644
index 0000000..1804dc8
--- /dev/null
+++ b/internal/schedule/cache_test.go
@@ -0,0 +1,31 @@
+package schedule
+
+import (
+	"context"
+	"testing"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+)
+
+type countingSource struct{ calls int }
+
+func (s *countingSource) Departures(ctx context.Context, stopID string) ([]Departure, error) {
+	s.calls++
+	return []Departure{{Route: "BRT Ikorodu–CMS", Platform: "2"}}, nil
+}
+
+func TestDeparturesAreCachedPerStop(t *testing.T) {
+	mr := miniredis.RunT(t)
+	source := &countingSource{}
+	cache := NewCache(redis.NewClient(&redis.Options{Addr: mr.Addr()}), source)
+
+	for i := 0; i < 3; i++ {
+		if _, err := cache.Departures(context.Background(), "ikeja"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if source.calls != 1 {
+		t.Fatalf("source called %d times, want 1", source.calls)
+	}
+}
