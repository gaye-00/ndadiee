diff --git a/web/src/trips/announce.ts b/web/src/trips/announce.ts
new file mode 100644
index 0000000..db65a73
--- /dev/null
+++ b/web/src/trips/announce.ts
@@ -0,0 +1,7 @@
+import type { Trip } from '../api/trips';
+
+/** One sentence per trip, as a rider would say it: « BRT Ikorodu–CMS, dans 4 minutes, quai 2 ». */
+export function announceTrip(trip: Trip): string {
+  const when = trip.minutes <= 0 ? 'à quai' : trip.minutes === 1 ? 'dans 1 minute' : `dans ${trip.minutes} minutes`;
+  return `${trip.route}, ${when}, quai ${trip.platform}`;
+}
